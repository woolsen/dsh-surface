{
  "name": "dsh-surface",
  "version": "0.1.0",
  "description": "Render live HTML pages inside DeepSeekRuntime conversations — previews, reports, and forms that can answer back.",
  "license": "MIT",
  "author": "woolsen",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis-plugin",
    "html",
    "iframe",
    "sandbox",
    "report",
    "preview",
    "generative-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woolsen/dsh-surface.git"
  },
  "homepage": "https://github.com/woolsen/dsh-surface#readme",
  "bugs": {
    "url": "https://github.com/woolsen/dsh-surface/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "oxlint src tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run format:check",
    "prepublishOnly": "npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.0",
    "typescript": "^5.7.0"
  }
}
